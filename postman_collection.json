    {
      "name": "2. Consultas públicas",
      "item": [
        {
          "name": "Preparar médico y variables de Fase 2",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/doctors",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "doctors"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const d = new Date();",
                  "d.setUTCDate(d.getUTCDate() + 30 + Math.floor(Math.random() * 3600));",
                  "const date = d.toISOString().slice(0, 10);",
                  "const startHour = 8 + Math.floor(Math.random() * 8);",
                  "const pad = n => String(n).padStart(2, \"0\");",
                  "pm.collectionVariables.set(\"phase2Date\", date);",
                  "pm.collectionVariables.set(\"phase2Start\", `${pad(startHour)}:00:00`);",
                  "pm.collectionVariables.set(\"phase2End\", `${pad(startHour + 1)}:00:00`);",
                  "pm.collectionVariables.set(\"overlapStart\", `${pad(startHour)}:30:00`);",
                  "pm.collectionVariables.set(\"overlapEnd\", `${pad(startHour + 1)}:30:00`);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.expect(json).to.be.an(\"array\").that.is.not.empty;",
                  "const doctor = json.find(d => d.email === \"doctor@citas.local\") || json[0];",
                  "pm.collectionVariables.set(\"doctorId\", doctor.id);",
                  "if (doctor.especialidades && doctor.especialidades.length > 0) {",
                  "  pm.collectionVariables.set(\"especialidadId\", doctor.especialidades[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Filtrar médicos por especialidad",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/doctors?especialidadId={{especialidadId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "doctors"
              ],
              "query": [
                {
                  "key": "especialidadId",
                  "value": "{{especialidadId}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
