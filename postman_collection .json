      "value": ""
    },
    {
      "key": "patientId",
      "value": "3"
    }
  ],
  "item": [
    {
      "name": "1. Autenticación JWT",
      "item": [
        {
          "name": "Login ADMIN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@citas.local\",\n  \"password\": \"Admin123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Genera JWT de administrador y guarda el token en adminToken."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.expect(data.token).to.be.a(\"string\").and.not.empty;",
                  "pm.expect(data.role).to.eql(\"ROLE_ADMIN\");",
                  "pm.collectionVariables.set(\"adminToken\", data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login DOCTOR",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"doctor@citas.local\",\n  \"password\": \"Doctor123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Genera JWT de médico y guarda el token en doctorToken."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.expect(data.token).to.be.a(\"string\").and.not.empty;",
                  "pm.expect(data.role).to.eql(\"ROLE_DOCTOR\");",
                  "pm.collectionVariables.set(\"doctorToken\", data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login inválido -> 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@citas.local\",\n  \"password\": \"incorrecta\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Credenciales inválidas devuelven 401\", function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Endpoints públicos Fase 1",
      "item": [
        {
          "name": "Listar médicos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/doctors",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "doctors"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.expect(data).to.be.an(\"array\");",
                  "if (data.length > 0) {",
                  "    pm.collectionVariables.set(\"doctorId\", data[0].id);",
                  "    if (data[0].especialidades && data[0].especialidades.length > 0) {",
                  "        pm.collectionVariables.set(\"especialidadId\", data[0].especialidades[0].id);",
                  "    }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Filtrar médicos por especialidad",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/doctors?especialidadId={{especialidadId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "doctors"
              ],
              "query": [
                {
                  "key": "especialidadId",
                  "value": "{{especialidadId}}"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.expect(pm.response.json()).to.be.an(\"array\");"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar horarios disponibles",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/schedules/available",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "schedules",
                "available"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.expect(data).to.be.an(\"array\");",
                  "if (data.length > 0) {",
                  "    pm.collectionVariables.set(\"doctorId\", data[0].medicoId);",
                  "    pm.collectionVariables.set(\"scheduleDate\", data[0].fecha);",
                  "    pm.collectionVariables.set(\"scheduleId\", data[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Filtrar horarios por médico y fecha",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/schedules/available?medicoId={{doctorId}}&fecha={{scheduleDate}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "schedules",
                "available"
              ],
              "query": [
                {
                  "key": "medicoId",
                  "value": "{{doctorId}}"
                },
                {
                  "key": "fecha",
                  "value": "{{scheduleDate}}"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.expect(data).to.be.an(\"array\");",
                  "data.forEach(h => {",
                  "    pm.expect(String(h.medicoId)).to.eql(pm.collectionVariables.get(\"doctorId\"));",
                  "    pm.expect(h.fecha).to.eql(pm.collectionVariables.get(\"scheduleDate\"));",
                  "    pm.expect(h.estado).to.eql(\"DISPONIBLE\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Fecha inválida -> 400",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/schedules/available?fecha=no-es-fecha",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "schedules",
                "available"
              ],
              "query": [
                {
                  "key": "fecha",
                  "value": "no-es-fecha"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Formato inválido devuelve 400\", function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
