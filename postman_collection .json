                "usuarios"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{doctorToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"DOCTOR recibe 403\", function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Sin JWT -> 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "usuarios"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Sin token recibe 401\", function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Reservas y validaciones Fase 2",
      "item": [
        {
          "name": "Reservar horario disponible -> 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/appointments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "appointments"]
            },
            "auth": {
              "type": "bearer",
              "bearer": [{"key": "token", "value": "{{doctorToken}}", "type": "string"}]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pacienteId\": {{patientId}},\n  \"medicoId\": {{doctorId}},\n  \"horarioId\": {{scheduleId}},\n  \"motivo\": \"Consulta de control\"\n}",
              "options": {"raw": {"language": "json"}}
            }
          },
          "response": [],
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test(\"Reserva creada\", function () { pm.response.to.have.status(201); });",
                "const data = pm.response.json();",
                "pm.expect(data.horarioId).to.eql(Number(pm.collectionVariables.get(\"scheduleId\")));"
              ]
            }
          }]
        },
        {
          "name": "Reservar el mismo horario -> 409",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {
              "raw": "{{baseUrl}}/api/v1/appointments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "appointments"]
            },
            "auth": {
              "type": "bearer",
              "bearer": [{"key": "token", "value": "{{doctorToken}}", "type": "string"}]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pacienteId\": {{patientId}},\n  \"medicoId\": {{doctorId}},\n  \"horarioId\": {{scheduleId}},\n  \"motivo\": \"Segundo intento\"\n}",
              "options": {"raw": {"language": "json"}}
            }
          },
          "response": [],
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test(\"Horario ocupado devuelve 409\", function () { pm.response.to.have.status(409); });"
              ]
            }
          }]
        },
        {
          "name": "Reserva sin datos obligatorios -> 400",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {
              "raw": "{{baseUrl}}/api/v1/appointments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "appointments"]
            },
            "auth": {
              "type": "bearer",
              "bearer": [{"key": "token", "value": "{{doctorToken}}", "type": "string"}]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"motivo\": \"\"\n}",
              "options": {"raw": {"language": "json"}}
            }
          },
          "response": [],
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test(\"Datos inválidos devuelven 400\", function () { pm.response.to.have.status(400); });",
                "pm.expect(pm.response.json().message).to.include(\"pacienteId\");"
              ]
            }
          }]
        }
      ]
